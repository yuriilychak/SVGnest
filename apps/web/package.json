{
  "name": "@svgnest/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-assets": "npm --workspace @svgnest/svg-format-algo run build && npm --workspace @svgnest/polygon-pack run build",
    "prebuild": "npm run prepare-assets",
    "build": "vite build",
    "predev": "npm run prepare-assets",
    "dev": "vite --host 0.0.0.0",
    "check": "vite build --emptyOutDir",
    "clean": "node ./scripts/clean.mjs"
  },
  "dependencies": {
    "@svgnest/polygon-pack": "file:../../packages/polygon-pack",
    "@svgnest/ai-format-plugin": "file:../../packages/ai-format-plugin",
    "@svgnest/svg-format-plugin": "file:../../packages/svg-format-plugin",
    "i18next": "^23.11.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2"
  },
  "devDependencies": {
    "sass": "^1.77.8",
    "vite": "^6.2.2"
  }
}
